# Copy to .env and fill in. Leave PORTAL_BASE_URL empty to use https://support.example.com.
PORTAL_BASE_URL=
PORTAL_USERNAME=
PORTAL_PASSWORD=
# URL layout of the portal. Empty = defaults /login, /home, /articles/, /categories/.
PORTAL_LOGIN_PATH=
PORTAL_HOME_PATH=
PORTAL_ARTICLE_PATH=
PORTAL_CATEGORY_PATH=
# Site name the portal appends to page titles (e.g. " | <name>"); stripped from article titles.
PORTAL_TITLE_SUFFIX=
