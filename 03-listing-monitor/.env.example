# Copy to .env and fill in. All settings use the LISTING_ prefix (see src/config.py).
# Lines that are commented out show the default; uncomment to override.
# Booleans take true/false; lists take JSON, e.g. ["a","b"].

# --- Required --------------------------------------------------------------
# Google Sheet key (the long id in the sheet's URL). Share the sheet with the
# service account's email.
LISTING_SPREADSHEET_ID=

# --- Portal & search -------------------------------------------------------
# LISTING_BASE_URL=https://listings.example.com
# LISTING_AREAS=["example-city"]
# LISTING_PRICE_MIN=
# LISTING_PRICE_MAX=
# LISTING_SORT=newest
# LISTING_MAX_PAGES=10
# LISTING_CONSECUTIVE_KNOWN_THRESHOLD=15
# LISTING_SCRAPE_DETAILS=true
# LISTING_HEADLESS=true
# LISTING_PAGE_DELAY_SECONDS=2.0
# LISTING_DETAIL_DELAY_SECONDS=3.0
# LISTING_DELAY_JITTER_FACTOR=0.5

# --- Google credentials ----------------------------------------------------
# Path to a service-account JSON key (never commit it).
# LISTING_GOOGLE_CREDENTIALS_PATH=credentials/service_account.json
# Docker only: base64 of the key file; the entrypoint decodes it to the path above.
LISTING_GOOGLE_CREDENTIALS_B64=

# --- Telegram alerts -------------------------------------------------------
# LISTING_TELEGRAM_ENABLED=false
# LISTING_TELEGRAM_DRY_RUN=false
# Bot token from @BotFather.
LISTING_TELEGRAM_BOT_TOKEN=
# LISTING_TELEGRAM_CHAT_IDS=[]
# LISTING_TELEGRAM_INCLUDE_SHEET_URL=true
# LISTING_BLOCK_ALERT_COOLDOWN_HOURS=24

# --- Bot-detection mitigation: fingerprint + proxy rotation ----------------
# LISTING_FINGERPRINT_ENABLED=true
# LISTING_PROXY_ENABLED=false
# LISTING_PROXY_SOURCE=file            # file | url | inline
# LISTING_PROXY_FILE_PATH=proxies.txt  # one proxy URL per line
# LISTING_PROXY_URL=
# LISTING_PROXY_LIST=[]
# LISTING_PROXY_ROTATION_STRATEGY=round_robin   # round_robin | random | least_used
# LISTING_PROXY_FALLBACK_DIRECT=true
# LISTING_PROXY_MAX_CONSECUTIVE_FAILURES=3
# LISTING_PROXY_MAX_TOTAL_FAILURES=10
# LISTING_PROXY_COOLDOWN_SECONDS=60.0

# --- Retries / circuit breaker ---------------------------------------------
# LISTING_MAX_RETRIES=3
# LISTING_BACKOFF_BASE_SECONDS=2.0
# LISTING_BACKOFF_MULTIPLIER=2.0
# LISTING_BACKOFF_MAX_SECONDS=60.0
# LISTING_CIRCUIT_FAILURE_THRESHOLD=5
# LISTING_CIRCUIT_RECOVERY_SECONDS=120.0

# --- Lifecycle (sold / withdrawn) tracking ---------------------------------
# LISTING_LIFECYCLE_SWEEP_ENABLED=false
# LISTING_LIFECYCLE_SWEEP_HOUR_UTC=6
# LISTING_SOLD_SWEEP_ENABLED=true
# LISTING_SOLD_SWEEP_MAX_PAGES=5
# LISTING_SOLD_STATUS_FILTER=["under_offer","sold"]
