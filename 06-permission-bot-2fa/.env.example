# Copy to .env and fill in. .env is git-ignored.

# Required: browser login (permission_bot.py, export_permissions.py)
PORTAL_USER=
PORTAL_PASS=
# Base32 TOTP secret shown when enrolling the authenticator app
PORTAL_TOTP_SECRET=

# Portal location
PORTAL_BASE_URL=https://portal.example.com
# Optional overrides (defaults derive from PORTAL_BASE_URL)
# LOGIN_URL=
# EXPORT_LOGIN_URL=
# API_TOKEN_URL=

# Optional: API credentials (explore_api.py)
API_CLIENT_ID=
API_CLIENT_SECRET=

# Optional: "false" shows the browser while debugging
HEADLESS=true
# Optional: where permission_bot.log is written (default: script directory)
# LOG_DIR=

# Optional: API base URL for explore_api.py (default: $PORTAL_BASE_URL/api/)
# API_BASE_URL=
