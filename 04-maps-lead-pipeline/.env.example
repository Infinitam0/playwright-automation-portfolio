# Copy to .env and fill in. App settings use the LEADS_ prefix; the two
# credentials below are also read without it. Never commit the filled-in file.

# Google Maps Platform key with "Places API (New)" enabled. Primary discovery source.
GOOGLE_MAPS_API_KEY=

# Anthropic API key for LLM-drafted emails. Leave empty to use the offline
# template drafter.
ANTHROPIC_API_KEY=

# Sender identity stamped into every draft. The draft lint blocks export while
# LEADS_SENDER_NAME is empty.
LEADS_SENDER_NAME=
LEADS_SENDER_ROLE=
LEADS_SENDER_COMPANY=
LEADS_SENDER_EMAIL=
LEADS_SENDER_PHONE=


# --- Optional tunables (defaults live in src/config.py) ---------------------
# LEADS_USER_AGENT=           # descriptive crawler UA with a contact URL
# LEADS_DRAFT_MODEL=
# LEADS_PER_HOST_DELAY_SECONDS=
# LEADS_MAX_CONCURRENCY=
# LEADS_PLACES_MAX_PAGES=
# LEADS_RESPECT_ROBOTS=        # robots.txt for the website crawl (default true)
# LEADS_MAPS_ENABLED=          # true opts in to --source maps (default false)
# LEADS_LOG_LEVEL=
